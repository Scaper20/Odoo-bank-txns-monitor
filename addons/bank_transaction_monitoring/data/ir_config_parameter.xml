<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Transactions are in Naira by default; NGN ships inactive in base. -->
    <record id="base.NGN" model="res.currency">
        <field name="active" eval="True"/>
    </record>

    <data noupdate="1">
        <record id="param_high_value_threshold" model="ir.config_parameter">
            <field name="key">bank_transaction_monitoring.high_value_threshold</field>
            <field name="value">10000000.0</field>
        </record>
        <record id="param_velocity_max_count" model="ir.config_parameter">
            <field name="key">bank_transaction_monitoring.velocity_max_count</field>
            <field name="value">5</field>
        </record>
        <record id="param_velocity_window_minutes" model="ir.config_parameter">
            <field name="key">bank_transaction_monitoring.velocity_window_minutes</field>
            <field name="value">10</field>
        </record>
        <record id="param_batch_size" model="ir.config_parameter">
            <field name="key">bank_transaction_monitoring.batch_size</field>
            <field name="value">1000</field>
        </record>
        <record id="param_max_attempts" model="ir.config_parameter">
            <field name="key">bank_transaction_monitoring.max_attempts</field>
            <field name="value">3</field>
        </record>
        <record id="param_time_budget_seconds" model="ir.config_parameter">
            <field name="key">bank_transaction_monitoring.time_budget_seconds</field>
            <field name="value">90</field>
        </record>
    </data>
</odoo>
