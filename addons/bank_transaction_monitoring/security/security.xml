<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_transaction_monitoring" model="ir.module.category">
        <field name="name">Transaction Monitoring</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_monitoring_user" model="res.groups">
        <field name="name">Analyst</field>
        <field name="category_id" ref="module_category_transaction_monitoring"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_monitoring_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_transaction_monitoring"/>
        <field name="implied_ids" eval="[(4, ref('group_monitoring_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
